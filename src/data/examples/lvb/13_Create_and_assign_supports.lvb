'Creates and assigns supports to points and surfaces, and gets the features the support is assigned on
$ENGINE=VBScript

' Get slab-surface, columns-lines, and column top points
Set surface1 = db().getObject("surface", 1) 'get surface with ID 1
surfPoints = newObjectSet().add(surface1).addLOF("Points").getObjects("Point")
topPoints = newObjectSet().add("point", 1).add("point", 2).add("point", 3).add("point", 4).getObjects("Point")
lines = newObjectSet().add(topPoints).addHOF("Lines").getObjects("Line")


'Create Fixed support

Set attr = db().createSupportStructural("Fixed")
' Restrict all degrees of freedom
Call attr.setStructural("R", "R", "R", "R", "R", "R") ' R=Restrained

' Assign on slab points and loadcase 1
Call attr.assignTo(surfPoints, 1)


'Create pinned support

Set attr = db().createSupportStructural("Pinned")
' Release all rotational degrees of freedom
Call attr.setStructural("R", "R", "R", "F", "F", "F") ' F=Free, R=Restrained

' Assign on column top points and loadcase 1
Call attr.assignTo(topPoints, 1)


'Create translation springs support

Set attr = db().createSupportStructural("Springs")
' Mark translational degrees of freedoms as strings
Call attr.setStructural("S", "S", "S", "F", "F", "F")
' Set springs stiffness (in model units)
sType = "Area" ' Spring stiffness distribution: "Total" for total stiffness, "Length" for length distribution, "Area" for area distribution
Call attr.setSpring(sType, 200, 200, 200, 0, 0, 0, 0, 0, 0)

' Assign on surface and loadcase 1
Call attr.assignTo(surface1, 1)


'Create/Assign mesh so that supports are visualised (1.0m element size)
Call db().createMeshLine("Dummy Line Mesh").setSize("BMI21", 1.0).assignTo(lines, 1)
Call db().createMeshSurface("Dummy Surface Mesh").setRegular("QTS4", 0, 0, True).assignTo(surface1, 1)
Call db().updateMesh()


'Get features (i.e. points, line, surfaces) where attribute is assigned

' Get all objects on which the thickness attribute is assigned
set getAsgn = newAssignment().setConsiderAllAssigns(True)
set assignedObjSet = newObjectSet().add(attr, getAsgn)

' To get the assigned objects for a specific loadcase, the loadcase can be specified with the setLoadset() method, for example:
' set getAsgn = newAssignment().setLoadset("Loadcase 1")

' Print number of geometries the attribute is assigned on
Call getTextWindow().writeLine(attr.getName() & " attribute is assigned on " & assignedObjSet.count("all") & " features")
